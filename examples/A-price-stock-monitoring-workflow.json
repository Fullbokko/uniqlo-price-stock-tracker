      "parameters": {
        "jsCode": "// 每件商品 × 每間門市 = 一筆請求（順位 1 是首選）\nconst STORES = [\n  { siteId: '1%%%%4', 門市: '%%%%%%', 順位: 1 },\n  { siteId: '1%%%%5', 門市: '%%%%%%', 順位: 2 },\n  { siteId: '1%%%%3', 門市: '%%%%%%', 順位: 3 },\n];\nconst out = [];\n$('分組').all().forEach((g, groupIndex) => {\n  for (const s of STORES) {\n    out.push({ json: { productCode: g.json.productCode, groupIndex, ...s } });\n  }\n});\nreturn out;"
